CONFIG_BOARD_TOOLCHAIN="arm-none-eabi"
CONFIG_BOARD_ARCHITECTURE="cortex-m7"
CONFIG_BOARD_CONSTRAINED_MEMORY=y
CONFIG_BOARD_SERIAL_GPS1="/dev/ttyS3"
CONFIG_BOARD_SERIAL_TEL1="/dev/ttyS4"
CONFIG_BOARD_SERIAL_TEL2="/dev/ttyS1"
CONFIG_BOARD_ROMFS_DESTINATION="embedded"
CONFIG_BOARD_ROMFS=y
CONFIG_BOARD_ROMFS_CUSTOM=y

# --- Drivers: none for now ---
# (leave all CONFIG_DRIVERS_* and CONFIG_COMMON_* as n / commented)

# --- Modules: minimal ---
CONFIG_MODULES_COMMANDER=n
CONFIG_MODULES_EVENTS=y
CONFIG_MODULES_SENSORS=n
CONFIG_MODULES_EKF2=n
CONFIG_MODULES_LOCAL_POSITION_ESTIMATOR=n
CONFIG_MODULES_ATTITUDE_ESTIMATOR_Q=n
CONFIG_MODULES_GYRO_CALIBRATION=n
CONFIG_MODULES_TEMPERATURE_COMPENSATION=n
CONFIG_MODULES_MAG_BIAS_ESTIMATOR=n

CONFIG_MODULES_MANUAL_CONTROL=n
CONFIG_MODULES_RC_UPDATE=n

CONFIG_MODULES_CONTROL_ALLOCATOR=n
CONFIG_MODULES_MC_RATE_CONTROL=n
CONFIG_MODULES_MC_ATT_CONTROL=n
CONFIG_MODULES_MC_POS_CONTROL=n
CONFIG_MODULES_MC_AUTOTUNE_ATTITUDE_CONTROL=n
CONFIG_MODULES_MC_HOVER_THRUST_ESTIMATOR=n

CONFIG_MODULES_NAVIGATOR=n
CONFIG_MODULES_LAND_DETECTOR=n
CONFIG_MODULES_FLIGHT_MODE_MANAGER=n
CONFIG_MODULES_VTOL_ATT_CONTROL=n
CONFIG_MODULES_ROVER_POS_CONTROL=n

CONFIG_MODULES_LOAD_MON=n
CONFIG_MODULES_LOGGER=n
CONFIG_MODULES_DATAMAN=n
CONFIG_MODULES_BATTERY_STATUS=n
CONFIG_MODULES_ESC_BATTERY=n
CONFIG_MODULES_GIMBAL=n
CONFIG_MODULES_LANDING_TARGET_ESTIMATOR=n
CONFIG_MODULES_AIRSPEED_SELECTOR=n
CONFIG_MODULES_SIMULATION_SIMULATOR_SIH=n
CONFIG_MODULES_MAVLINK=n
CONFIG_MODULES_UXRCE_DDS_CLIENT=n

# --- System commands: keep only what's useful for bring-up ---
CONFIG_SYSTEMCMDS_NSHTERM=y
CONFIG_SYSTEMCMDS_REBOOT=n
CONFIG_SYSTEMCMDS_VER=y
CONFIG_SYSTEMCMDS_TOP=n
CONFIG_SYSTEMCMDS_WORK_QUEUE=y
CONFIG_SYSTEMCMDS_UORB=y
CONFIG_SYSTEMCMDS_PARAM=y
CONFIG_SYSTEMCMDS_MTD=n
CONFIG_SYSTEMCMDS_MFT=y
CONFIG_SYSTEMCMDS_I2CDETECT=n
CONFIG_SYSTEMCMDS_SD_BENCH=n
CONFIG_SYSTEMCMDS_SD_STRESS=n
CONFIG_SYSTEMCMDS_SERIAL_TEST=y
CONFIG_SYSTEMCMDS_USB_CONNECTED=n
CONFIG_SYSTEMCMDS_TUNE_CONTROL=n
CONFIG_SYSTEMCMDS_LED_CONTROL=n
CONFIG_SYSTEMCMDS_PERF=n
CONFIG_SYSTEMCMDS_DUMPFILE=n
CONFIG_SYSTEMCMDS_BSONDUMP=y
CONFIG_SYSTEMCMDS_REFLECT=n
CONFIG_SYSTEMCMDS_SYSTEM_TIME=n
CONFIG_SYSTEMCMDS_TOPIC_LISTENER=n

# --- Examples: disable ---
CONFIG_EXAMPLES_FAKE_GPS=n
