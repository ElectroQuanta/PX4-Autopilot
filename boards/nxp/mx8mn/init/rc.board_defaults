#!/bin/sh
#
# board specific defaults
#--------------------------------------------------------------------------

echo ">> PX4 ROMFS rc.board_defaults running"

# AIRFRAME = NXP HoverGames
param set-default SYS_AUTOSTART 4017
param set-default MAV_SYS_ID 1
# Use dataman from RAM
param set-default SYS_DM_BACKEND 1

if [ -f "/fs/mtd_params" ]
then
    echo ">> [FS] Persistent parameters ready in RAM. Loading..."
    param select /fs/mtd_params
    param load
else
    echo ">> [FS] No persistent parameters found. Using RAM defaults."
    param select /fs/mtd_params
fi

if [ -f "/fs/mtd_caldata" ]
then
    echo ">> [FS] Loading calibration from RAM shadow..."
    param load /fs/mtd_caldata
fi

if [ -d "/mnt/linux" ]
then
    set LOGGER_ARGS "-rootfs /mnt/linux"
    echo ">> [FS] Logger redirected to Linux persistent storage"
fi

echo "Board defaults processed"
