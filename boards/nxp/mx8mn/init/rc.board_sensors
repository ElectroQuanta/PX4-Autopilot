#!/bin/sh
#
# NXP mx8mn specific board defaults
#------------------------------------------------------------------------------

echo ">> PX4 ROMFS rc.board_sensors running"

# Barometer (on I2C bus defined in i2c.cpp)
if ! bmp280 start -I -a 0x76; then
    echo "WARN [init] failed to initialize barometer bmp280"
fi

# External (if any) or internal
if ! ist8310 start -I -a 0x0e -R 0; then
    echo "WARN [init] failed to initialize magnetometer ist8310"
fi

# IMUs (on SPI bus defined in spi.cpp)
# ECSPI2 CS 2 -> ICM42688P: ROTATION_PITCH_180
if ! icm42688p start -s -R 12; then
    echo "WARN [init] failed to initialize IMU icm42688p"
fi

# ECSPI2 CS 1/0 -> BMI088 (Accel/Gyro) - ROTATION_PITCH_180
if ! bmi088 start -A -s -R 12; then
    echo "WARN [init] failed to initialize IMU bmi088 accel"
fi
if ! bmi088 start -G -s -R 12; then
    echo "WARN [init] failed to initialize IMU bmi088 gyro"
fi
